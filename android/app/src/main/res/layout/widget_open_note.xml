<?xml version="1.0" encoding="utf-8"?>
<!-- Open note: a shortcut to one chosen note, with its name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/widget_open"
        android:src="@drawable/ic_widget_note" />
    <TextView
        android:id="@+id/open_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_setup"
        android:textColor="@color/nss_text"
        android:textSize="13sp" />
</LinearLayout>
