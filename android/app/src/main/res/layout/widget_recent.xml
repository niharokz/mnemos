<?xml version="1.0" encoding="utf-8"?>
<!-- Recent notes: opened or changed lately (names only, so it can show while locked). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/widget_recent_header"
        android:textColor="@color/nss_ink"
        android:textSize="13sp" />
    <ListView
        android:id="@+id/recent_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:divider="@null" />
    <TextView
        android:id="@+id/recent_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_no_recent"
        android:textColor="@color/nss_muted"
        android:textSize="13sp" />
</LinearLayout>
