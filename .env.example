# Copy to .env and fill in. .env is gitignored — never commit it.
# A .env shared with other apps is fine: docker-compose.yml passes only TZ and
# the MNEMOS_* variables into the container, never the rest of the file.

# ---- used by docker-compose (host side) ------------------------------------
# Your notes folder on the host (e.g. the folder Obsidian or Syncthing uses).
NOTE_PATH=/path/to/notes
# The user that owns NOTE_PATH (from `id -u` / `id -g`). The container runs as
# this user, so it can write your notes and new files stay yours.
PUID=1000
PGID=1000
# Time zone (used in capture time stamps and the names of conflict copies).
TZ=Asia/Kolkata
# The Docker network your reverse proxy is on (created beforehand, external).
MNEMOS_NETWORK=homelab

# ---- used by mnemos --------------------------------------------------------
# Your sign-in. Store a bcrypt hash rather than the password itself:
#   read -rs PW && printf '%s' "$PW" | docker run --rm -i mnemos:local hash-password
# and wrap the hash in single quotes so the $ signs are kept:
#   MNEMOS_PASSWORD='$2a$12$…'
MNEMOS_USER=me
MNEMOS_PASSWORD=change-me
# Long random string that signs sessions (keeps you signed in across restarts):
#   openssl rand -hex 32
MNEMOS_SECRET=

# Optional ----------------------------------------------------------------------
# Extra folders/files to hide, comma separated (names or vault paths). Anything
# starting with a dot (.obsidian, .trash, .stfolder, .git …) is always hidden.
MNEMOS_HIDDEN=
# Autosave delay after you stop typing, in milliseconds (300–60000).
MNEMOS_AUTOSAVE_MS=1000
# Files bigger than this (MB) open read-only (1–100).
MNEMOS_MAX_FILE_MB=5
# Largest image (MB) that can be pasted or uploaded into a note (1–200).
MNEMOS_MAX_UPLOAD_MB=20
# Quick capture (Alt+C, the phone share target) appends to this note.
MNEMOS_CAPTURE=inbox/note.md
# "New from template" lists the notes in this folder ({{date}} {{time}} {{title}} are filled in).
MNEMOS_TEMPLATES=templates

# Read-only demo user with a built-in sample vault, shown on the sign-in card.
# It never sees your notes and the server refuses every change it sends.
# Set MNEMOS_DEMO=false to turn it off.
MNEMOS_DEMO=true
MNEMOS_DEMO_USER=demouser
MNEMOS_DEMO_PASSWORD=demo

# Moving from Samanote? SAMANOTE_* variables still work (a note in the log names
# each one); rename them to MNEMOS_* when convenient.
