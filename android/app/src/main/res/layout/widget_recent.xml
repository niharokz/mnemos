<?xml version="1.0" encoding="utf-8"?>
<!-- Recent notes: opened or changed lately (names only, so it can show while locked). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="@string/widget_recent_header"
            android:textColor="@color/nss_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/recent_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/nss_muted"
            android:textSize="11sp" />
        <ImageView
            android:id="@+id/recent_new"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="@string/widget_act_new"
            android:padding="5dp"
            android:src="@drawable/ic_shortcut_new" />
    </LinearLayout>
    <ListView
        android:id="@+id/recent_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@null"
        android:scrollbars="none" />
    <TextView
        android:id="@+id/recent_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_no_recent"
        android:textColor="@color/nss_muted"
        android:textSize="13sp" />
</LinearLayout>
