<?xml version="1.0" encoding="utf-8"?>
<!-- Open note, 2x1: icon beside the name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">
    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@string/widget_open"
        android:src="@drawable/ic_widget_note" />
    <TextView
        android:id="@+id/open_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_setup"
        android:textColor="@color/nss_text"
        android:textSize="14sp" />
</LinearLayout>
