# Copy to .env and fill in. .env is gitignored — never commit it.
# A .env shared with other apps is fine: docker-compose.yml passes only TZ and
# the SAMANOTE_* variables into the container, never the rest of the file.

# ---- used by docker-compose (host side) ------------------------------------
# Your notes folder on the host (e.g. the folder Obsidian or Syncthing uses).
NOTE_PATH=/path/to/notes
# The user that owns NOTE_PATH (from `id -u` / `id -g`). The container runs as
# this user, so it can write your notes and new files stay yours.
PUID=1000
PGID=1000
# Time zone (used in the names of conflict copies).
TZ=Asia/Kolkata
# The Docker network your reverse proxy is on (created beforehand, external).
SAMANOTE_NETWORK=homelab

# ---- used by samanote --------------------------------------------------------
# Your sign-in. Store a bcrypt hash rather than the password itself:
#   read -rs PW && printf '%s' "$PW" | docker run --rm -i samanote:local hash-password
# and wrap the hash in single quotes so the $ signs are kept:
#   SAMANOTE_PASSWORD='$2a$12$…'
SAMANOTE_USER=me
SAMANOTE_PASSWORD=change-me
# Long random string that signs sessions (keeps you signed in across restarts):
#   openssl rand -hex 32
SAMANOTE_SECRET=

# Optional ----------------------------------------------------------------------
# Extra folders/files to hide, comma separated (names or vault paths). Anything
# starting with a dot (.obsidian, .trash, .stfolder, .git …) is always hidden.
SAMANOTE_HIDDEN=
# Autosave delay after you stop typing, in milliseconds (300–60000).
SAMANOTE_AUTOSAVE_MS=1000
# Files bigger than this (MB) open read-only (1–100).
SAMANOTE_MAX_FILE_MB=5
