# Copy to .env and fill in (or symlink .env to a shared homelab .env that has
# these keys). .env is gitignored — never commit it.

# ---- used by docker-compose (host side) ------------------------------------
# The vault on the host (the folder Obsidian / Syncthing use).
NOTE_PATH=/path/to/notes
# UID/GID that owns NOTE_PATH (the container runs as this user, so new files are yours).
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# ---- used by samanote --------------------------------------------------------
# Your sign-in. The password may be plain text or a bcrypt hash from:
#   docker compose run --rm -it samanote hash-password
# (wrap a hash in single quotes so the $ signs are kept)
SAMANOTE_USER=me
SAMANOTE_PASSWORD=change-me
# Long random string that signs sessions (keeps you signed in across restarts):
#   openssl rand -hex 32
SAMANOTE_SECRET=

# Optional ----------------------------------------------------------------------
# Extra folders/files to hide, comma separated (names or vault paths). Anything
# starting with a dot (.obsidian, .trash, .stfolder, .git …) is always hidden.
SAMANOTE_HIDDEN=
# Autosave delay after you stop typing, in milliseconds.
SAMANOTE_AUTOSAVE_MS=1000
# Files bigger than this (MB) open read-only.
SAMANOTE_MAX_FILE_MB=5
